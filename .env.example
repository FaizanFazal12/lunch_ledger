# --- Database ---
DATABASE_URL="postgresql://lunchledger:lunchledger@localhost:5433/lunchledger?schema=public"

# --- AI provider (priority: OpenRouter > Gemini > offline mock) ---

# Option 1 (recommended): OpenRouter — OpenAI-compatible gateway with free models.
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# A free model that supports tool calling (needed for structured extraction).
# Examples: openai/gpt-oss-20b:free, google/gemma-4-31b-it:free
OPENROUTER_MODEL="openai/gpt-oss-20b:free"

# Option 2: Google Gemini — https://aistudio.google.com/app/apikey
# Google retires older models for new keys — the whole 2.x flash family now 404s with
# "no longer available to new users". Pin a current one; list what your key can reach:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GOOGLE_API_KEY"
# Use a *-flash-lite model if you hit free-tier limits.
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# When neither key is set, the AI layer falls back to a deterministic mock parser,
# so the graph and business logic still run offline (useful for tests/CI).

# --- API server ---
PORT=3001
HOST="0.0.0.0"
LOG_LEVEL="info"

# --- Default request context (apps/api/.env only) ---
# Run `pnpm db:seed` and paste the GROUP_ID / CURRENT_USER_ID it prints here. Until they
# are set, POST /ai/message needs an explicit groupId and `pnpm chat` has no group.
SEED_GROUP_ID=""
SEED_USER_ID=""
